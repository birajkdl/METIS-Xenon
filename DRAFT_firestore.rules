rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && (
        request.auth.token.email_verified == true ||
        request.auth.token.firebase.sign_in_provider == 'password'
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'birajkdl@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Entity validation helpers
    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
        data.uid is string && data.uid.size() <= 128 &&
        data.email is string && data.email.size() <= 256 &&
        data.role is string && (
          data.role == 'Super Administrator' ||
          data.role == 'Administrator' ||
          data.role == 'Meteorologist' ||
          data.role == 'Technician' ||
          data.role == 'Viewer'
        ) &&
        (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 128)) &&
        (!('office' in data) || (data.office is string && data.office.size() <= 128)) &&
        (!('createdAt' in data) || data.createdAt is timestamp) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidUserPreference(data) {
      return data.keys().hasAll(['userId']) &&
        data.userId is string && data.userId.size() <= 128 &&
        (!('theme' in data) || (data.theme in ['light', 'dark', 'system'])) &&
        (!('autoRefresh' in data) || data.autoRefresh is bool) &&
        (!('pinnedStationIds' in data) || (data.pinnedStationIds is list && data.pinnedStationIds.size() <= 100)) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    function isValidSystemAnnouncement(data) {
      return data.keys().hasAll(['id', 'title', 'message', 'severity', 'createdBy']) &&
        data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() <= 200 &&
        data.message is string && data.message.size() <= 2000 &&
        data.severity is string && (data.severity in ['info', 'warning', 'critical']) &&
        data.createdBy is string && data.createdBy.size() <= 128 &&
        (!('createdAt' in data) || data.createdAt is timestamp);
    }

    // Connection validation check doc
    match /test/{docId} {
      allow get: if isValidId(docId);
    }

    // User Profiles Collection
    match /users/{userId} {
      allow get: if isValidId(userId) && (isOwner(userId) || isAdmin());
      allow list: if isAdmin();
      
      allow create: if isValidId(userId) && isOwner(userId) && isVerified() &&
        isValidUserProfile(incoming()) &&
        incoming().uid == userId &&
        (isAdmin() || incoming().role == 'Viewer');

      allow update: if isValidId(userId) && isVerified() && isValidUserProfile(incoming()) && (
        isAdmin() ||
        (
          isOwner(userId) &&
          incoming().uid == existing().uid &&
          incoming().email == existing().email &&
          incoming().role == existing().role &&
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'office', 'updatedAt'])
        )
      );

      allow delete: if isValidId(userId) && isAdmin();

      // Subcollection: Preferences
      match /preferences/{prefId} {
        allow get, list: if isValidId(prefId) && (isOwner(userId) || isAdmin());
        allow create: if isValidId(prefId) && isOwner(userId) && isVerified() &&
          isValidUserPreference(incoming()) &&
          incoming().userId == userId;
        allow update: if isValidId(prefId) && isOwner(userId) && isVerified() &&
          isValidUserPreference(incoming()) &&
          incoming().userId == existing().userId;
        allow delete: if isValidId(prefId) && (isOwner(userId) || isAdmin());
      }
    }

    // System Announcements Collection
    match /announcements/{annId} {
      allow read: if isValidId(annId);
      allow create: if isValidId(annId) && isAdmin() &&
        isValidSystemAnnouncement(incoming()) &&
        incoming().createdBy == request.auth.uid;
      allow update: if isValidId(annId) && isAdmin() &&
        isValidSystemAnnouncement(incoming());
      allow delete: if isValidId(annId) && isAdmin();
    }
  }
}
